items.CozyRanch_Toy_ScratchingPost.description=A sturdy post for a good scratch. Cows and sheep love it.
items.CozyRanch_Toy_HangingBell.name=Hanging Bell
items.CozyRanch_Toy_HangingBell.description=A little bell to peck and ring. Chickens love it.
items.CozyRanch_Toy_FloatingDuck.name=Floating Duck
items.CozyRanch_Toy_FloatingDuck.description=A wooden duck that floats on the pond. Frogs love it.
