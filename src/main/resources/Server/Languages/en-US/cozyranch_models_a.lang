items.CozyRanch_House_ChickenCoop.name = Chicken Coop
items.CozyRanch_House_ChickenCoop.description = A snug coop on stilts with a little ramp. Chickens climb up and tuck in for the night.
items.CozyRanch_House_Pigsty.name = Pigsty
items.CozyRanch_House_Pigsty.description = A cozy plank hut with a trough and a mud wallow. Pigs could not be happier.
items.CozyRanch_House_FrogPond.name = Frog Pond
items.CozyRanch_House_FrogPond.description = A mossy pond with lily pads and a toadstool hut where frogs settle in to sleep.
