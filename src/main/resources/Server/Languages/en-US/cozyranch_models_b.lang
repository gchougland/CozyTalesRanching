items.CozyRanch_House_CowBarn.name = Cow Barn
items.CozyRanch_House_CowBarn.description = A cosy red barn with a hayloft and a little cupola. Cows come home here to sleep.
items.CozyRanch_House_Sheepfold.name = Sheepfold
items.CozyRanch_House_Sheepfold.description = A snug stone cottage under a thatch roof, with a hay rack by the door. Sheep tuck in here at night.
items.CozyRanch_Trough.name = Feeding Trough
items.CozyRanch_Trough.description = A sturdy wooden trough. Fill it with food and every animal on the ranch can share it.
