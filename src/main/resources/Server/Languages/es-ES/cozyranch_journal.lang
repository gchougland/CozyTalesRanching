settings.chat.name=Mensajes del rancho
settings.chat.desc=Líneas de chat para cuando alimentes, acaricies, te hagas amigo o alojes a un animal, visitas y notas de diario.
settings.sounds.name=sonidos de rancho
settings.sounds.desc=Sonidos de tus animales, casas, comederos y este diario.
settings.on=En
settings.off=Apagado
settings.always.title=Siempre se muestra
settings.always.intro=Algunos mensajes aún se muestran con los mensajes de ranch desactivados:
settings.always.1=Por qué algo no funcionó.
settings.always.2=Ofertas y novedades de otros jugadores.
settings.always.3=Responde a tus órdenes.
