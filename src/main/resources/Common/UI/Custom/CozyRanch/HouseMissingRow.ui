$C = "../Common.ui";
$H = "HouseStyles.ui";

// Hover the tag or the name to read what counts (the tooltip text is set from Java).
Group #MissingRow {
  LayoutMode: Left;
  Anchor: (Height: 22);

  Label #MNeed {
    Style: (FontSize: 12, TextColor: #f0a0ae, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
    Anchor: (Width: 92);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    Visible: false;
    Text: "";
  }

  Label #MWant {
    Style: (FontSize: 12, TextColor: #c9b48a, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
    Anchor: (Width: 92);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    Visible: false;
    Text: "";
  }

  Label #MName {
    FlexWeight: 1;
    Style: (...$H.@BodyStyle, VerticalAlignment: Center);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    Text: "";
  }
}
