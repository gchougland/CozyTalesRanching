{
  "cases": [
    {
      "name": "resident stays home in a paused chunk",
      "description": "Port 5603. The player report: chickens out at their coop, the owner 400 blocks away, past the ticking range but with the coop still in view, so its chunk stays loaded and pauses. Recovery took about 110 s to bring them to the owner. Now they are not missing: after 130 s none is beside the owner, the records are ACTIVE, and they are at the coop when the owner returns.",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.3.jar"
            ],
            "authMode": "insecure",
            "port": 5603
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555",
            "timeoutMs": 120000
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_send",
          "name": "view radius 24 chunks",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "packet",
            "name": "ViewRadius",
            "fields": {
              "value": 768
            }
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/gamemode creative"
          },
          "save": "s1"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/time 7"
          },
          "save": "s2"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug nightfall"
          },
          "save": "s3"
        },
        {
          "tool": "bot_expect",
          "name": "forced night",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${s3.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.nightfall"
              }
            },
            "timeoutMs": 15000
