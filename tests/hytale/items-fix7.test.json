{
  "cases": [
    {
      "name": "items-fix7 gate",
      "description": "The pack validates and every Java selector resolves.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0,
            "errors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
    {
      "name": "items-fix7 files",
      "description": "Note 1: the poop pile and its states carry Gathering.Harvest with the same drop list as breaking, and the vanilla gather hint. Note 3: the Climbing Log recipe asks for Wood_Trunk (Any Tree Log), which every vanilla trunk carries.",
      "steps": [
        {
          "tool": "asset_check",
          "name": "CozyRanch_Poop_Pile",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Poop/CozyRanch_Poop_Pile.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_Toy_Log",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_Log.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "vanilla Wood_Oak_Trunk (carries Wood_Trunk) checks clean",
          "arguments": {
            "root": "assets",
            "path": "Server/Item/Items/Wood/Oak/Wood_Oak_Trunk.json"
          },
          "expect": {
            "errors": 0
          }
        }
      ]
    },
    {
