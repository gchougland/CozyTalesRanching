{
  "cases": [
    {
      "name": "art-fix5a gate",
      "description": "The pack parses and matches the engine schemas; the three items and the bench hitbox (unchanged) check clean.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "item RanchingBench",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "hitbox RanchingBench",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Block/Hitboxes/CozyRanch/CozyRanch_RanchingBench.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "item WolfLodge",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_WolfLodge.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "item FlamingoNest",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_FlamingoNest.json"
          },
          "expect": {
            "errors": 0
          }
        }
      ]
    },
    {
      "name": "art-fix5a RanchingBench",
      "description": "Gibson's note 8: the bench at vanilla bench detail. Same footprint (2 x 1 cells, under 1.8 blocks), boxes for mass and painted planes for straw, carrot tops, the quill, wheat and the blanket fringe; under 255 nodes; the texture passes the style check; the icon re-rendered. Before: tests/hytale/golden/art-fix5a/before/RanchingBench.png.",
      "steps": [
        {
          "tool": "model_render",
          "name": "RanchingBench views",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json",
            "views": [
              "three_quarter",
              "front",
              "back_three_quarter",
              "left"
            ],
            "grid": true,
            "size": 384
          },
          "expect": {
            "notes": {
              "$length": 0
            },
            "nodes": {
              "$lte": 255
            },
            "sizeBlocks": {
              "width": {
                "$lte": 2
              },
              "height": {
                "$lte": 1.8
              },
              "depth": {
                "$lte": 1
              }
            }
          },
          "golden": "tests/hytale/golden/art-fix5a/RanchingBench.png"
        },
        {
          "tool": "model_render",
          "name": "RanchingBench close",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json",
            "yaw": 30,
            "pitch": 22,
            "size": 900,
            "grid": false
          },
          "expect": {
            "notes": {
              "$length": 0
            }
          },
          "golden": "tests/hytale/golden/art-fix5a/RanchingBench_close.png"
        },
        {
          "tool": "texture_check",
          "name": "RanchingBench texture",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json",
            "image": false
          },
          "expect": {
            "verdict": {
              "$oneOf": [
                "PASS",
                "WARN"
              ]
            }
          }
        },
        {
          "tool": "texture_preview",
          "name": "bench icon",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Common/Icons/ItemsGenerated/CozyRanch_RanchingBench.png"
          },
          "golden": "tests/hytale/golden/art-fix5a/RanchingBench_icon.png"
        }
      ]
    },
