{
  "cases": [
    {
      "name": "wildlife gate",
      "description": "The pack parses and matches the engine schemas, with the rare roles and models in it.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        }
      ]
    },
    {
      "name": "rare chicken",
      "description": "A golden hen: the cream feathers turned rich gold, comb and wattle still red, legs still yellow.",
      "steps": [
        {
          "tool": "asset_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/NPC/Roles/CozyRanchWild/CozyRanchWild_Chicken_Golden.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/NPC/Roles/CozyRanch/Rare/CozyRanch_Chicken_Golden.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/Rare/CozyRanch_Chicken_Golden.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "model_render",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/Rare/CozyRanch_Chicken_Golden.json",
            "views": [
              "three_quarter"
            ],
            "size": 300
          },
          "expect": {
            "notes": {
              "$length": 0
            },
            "coverage": {
              "$gt": 0.03
            }
          },
          "golden": "tests/hytale/golden/wildlife/chicken-rare.png"
        },
        {
          "tool": "texture_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Common/NPC/CozyRanch/Rare/Chicken_Golden.png"
          },
          "expect": {
            "verdict": {
              "$oneOf": [
                "PASS",
                "WARN"
              ]
            }
          }
        }
      ]
    },
