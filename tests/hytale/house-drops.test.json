    {
      "name": "a broken barn does not drop its milk",
      "description": "Port 5640. Milk waiting in a cow barn takes one empty bucket each to collect. Breaking the barn used to drop it all as filled buckets, a way round needing buckets. Now none is on the ground or in the inventory, and the owner is told how much was lost.",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.3.jar"
            ],
            "authMode": "insecure",
            "port": 5640
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555",
            "timeoutMs": 120000
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/gamemode creative"
          },
          "save": "s1"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/time 7"
          },
          "save": "s2"
        },
        {
          "tool": "bot_expect",
          "name": "wait: creative mode is on, which /clear needs",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "WaitOnlyNoSuchPacket",
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/block set ~-2 ~-1 ~-2 Rock_Stone"
          },
          "save": "s3"
