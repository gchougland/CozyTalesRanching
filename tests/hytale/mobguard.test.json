  "cases": [
    {
      "name": "mobguard gate",
      "description": "Assets and UI selectors.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
