    {
      "name": "mobguard live: hostile mobs cannot kill owned ranch animals",
      "description": "Gibson, fix round 4: 'enemies killed them'. Owned animals of seven species (wolf, bat, penguin, the rare Storm Snail, a chick, hawk, sparrow), staying put, with a goblin scrapper, skeleton archer, goblin lobber, trork warrior and spider spawned among them, burning and poisoned by effects nobody owns: a 1000 hit from the nearest mob, a 1000 hit from a mob that is gone (its arrow or burn landing after it died), a 1000 fall, and after the burn and poison have ticked all seven are still there and alive.",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.1.jar"
            ],
            "authMode": "insecure",
            "port": 5600
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555556"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555556"
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch ping"
          },
          "save": "ping"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${ping.cursor}",
            "where": {}
          },
          "expect": {
            "matched": true
          }
        },
