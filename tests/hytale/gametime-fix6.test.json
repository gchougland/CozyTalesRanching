{
  "cases": [
    {
      "name": "gametime fix6 gate",
      "description": "Assets and UI selectors of the worktree (Produce.json gains TimeJumpCapGameDays).",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
    {
      "name": "gametime fix6 build and unit tests (GameTimeRulesTest: vanilla day numbers, a slept night, back and forward, pause, cap, sweep, timer shift)",
      "steps": [
        {
          "tool": "project_build",
          "arguments": {
            "project": "CozyTales-Ranching",
            "system": "gradle",
            "tasks": [
              "build"
            ]
          },
          "waitJob": true,
          "expect": {
            "state": "succeeded"
          }
        }
      ]
    },
    {
      "name": "gametime fix6 live: skipped game time produces",
      "description": "Note 9. A chicken coop with two happy chickens. /time jumps game time forward the way waking from sleep does (one setGameTime): 07:00 to 21:00 is 14 in-game hours, 28 real-equivalent minutes, so each 25-minute chicken lays an egg (2+); 21:00 to 06:00 is the slept night, 18 minutes, so the house has 4+ by morning. The server log says 'Game time in default jumped ...'.",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.0.jar"
            ],
            "authMode": "insecure",
            "port": 5615
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555",
            "name": "RanchBot"
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/time 7"
          },
          "save": "t7"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${t7.cursor}",
            "where": {
              "message": {
                "messageId": "server.commands.time.set"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug place chicken"
          },
          "save": "place"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${place.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.placed"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch breed testhouse chicken"
          },
          "save": "th"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${th.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_breeding.debug.testhouse.done"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/time 21"
          },
          "save": "t21"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${t21.cursor}",
            "where": {
              "message": {
                "messageId": "server.commands.time.set"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch produce status"
          },
          "save": "s1"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${s1.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_produce.status.house",
                "params": {
                  "total": {
                    "value": {
                      "$gte": 2
                    }
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/time 6"
          },
          "save": "t6"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${t6.cursor}",
            "where": {
              "message": {
                "messageId": "server.commands.time.set"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch produce status"
          },
          "save": "s2"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${s2.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_produce.status.house",
                "params": {
                  "total": {
                    "value": {
                      "$gte": 4
                    }
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        }
      ]
    }
  ]
}