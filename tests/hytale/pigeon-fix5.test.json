{
  "cases": [
    {
      "name": "pigeon fix5 live: the handgun habit plays",
      "description": "Note 18: a ranch pigeon living in a Dovecote is forced into pigeon_handgun once the house morning has let it out at noon; the planner starts it (force.done). The manual run on 2026-10-25 also showed the log line \"starts pigeon_handgun with Handgun\" and no missing-animation warning for any ranch model. (No server_scenario steps: the MCP refuses a fourth running job.)",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.1.jar"
            ],
            "authMode": "insecure",
            "port": 5605
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555"
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug place pigeon"
          },
          "save": "place"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${place.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.placed"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch breed testhouse pigeon"
          },
          "save": "house"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${house.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_breeding.debug.testhouse.done"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug morning"
          },
          "save": "morning"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${morning.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.morning"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "time set noon"
          }
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${morning.cursor}",
            "where": {
              "message": {
                "messageId": "never.arrives.wait"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch behaviour force nearest pigeon_handgun"
          },
          "save": "force"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${force.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_behaviour.force.done"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${force.cursor}",
            "where": {
              "message": {
                "messageId": "never.arrives.wait"
              }
            },
            "timeoutMs": 6000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_stop",
          "arguments": {
            "botId": "${bot.botId}"
          }
        },
        {
          "tool": "job_stop",
          "arguments": {
            "jobId": "${server.id}"
          }
        }
      ]
    }
  ]
}
