    {
      "name": "compat fix7 live: a bred chick gets a skin and keeps it when it grows up",
      "description": "Two plain parents breed in a Fossil Nest with corn in the trough. Neither has a skin, so the chick rolls one from the wild Tetrabird's sets (the skin pack's); it wears it as a chick and keeps the same ids and attachments as a grown CozyRanch_Tetrabird.",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.0.jar",
              "CozyTales-Ranching/build/skinsmod/Cellys_Wildlife_Skins_v1.3.1.zip"
            ],
            "authMode": "insecure",
            "port": 5622
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555",
            "name": "RanchBot"
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_expect",
          "name": "wait 4000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 4000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/gamemode creative"
          },
          "save": "s1"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug place tetrabird"
          },
          "save": "place"
        },
        {
          "tool": "bot_expect",
          "name": "Fossil Nest placed",
