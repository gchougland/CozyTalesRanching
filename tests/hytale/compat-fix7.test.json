        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch admin skins --radius=12 --release"
          },
          "save": "rel"
        },
        {
          "tool": "bot_expect",
          "name": "released",
          "arguments": {
