          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display refresh"
          },
          "save": "s14"
        },
        {
          "tool": "bot_expect",
          "name": "wait 1000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 1000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display status"
          },
          "save": "disp"
        },
        {
          "tool": "bot_expect",
          "name": "the house display shows it with its 3 skin attachments",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${disp.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.status.line",
                "params": {
                  "models": {
                    "value": {
                      "$matches": "CozyRanch_Tetrabird x[0-9.]+ at [^\\]]*\\+3 attachments\\]"
                    }
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug morning"
          },
          "save": "s16"
        },
        {
          "tool": "bot_expect",
