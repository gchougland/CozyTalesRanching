{
  "cases": [
    {
      "name": "compat fix7 gate",
      "description": "Assets and UI selectors of the worktree.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
    {
      "name": "compat fix7 build and unit tests (SkinRulesTest: resolve, merge, inherit, save)",
      "steps": [
        {
          "tool": "project_build",
          "arguments": {
            "project": "CozyTales-Ranching",
            "system": "gradle",
            "tasks": [
              "build"
            ]
          },
          "waitJob": true,
          "expect": {
            "state": "succeeded"
          }
        }
      ]
    },
    {
      "name": "compat fix7 live: a skinned wild animal keeps its skin when tamed, reloaded, housed and released",
      "description": "Note 5. Celly's Wildlife Skins (a copy of its zip in build/skinsmod) loads beside the jar. A wild Tetrabird gets a known skin from the pack's own sets, is befriended, and keeps the same attachments on CozyRanch_Tetrabird (server state and the EntityUpdates sent to the client), after its chunk unloads and reloads, on the house display, out of the house, and back on its wild model when released.",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.0.jar",
              "CozyTales-Ranching/build/skinsmod/Cellys_Wildlife_Skins_v1.3.1.zip"
            ],
            "authMode": "insecure",
            "port": 5622
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555",
            "name": "RanchBot",
            "decode": [
              "EntityUpdates"
            ]
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_expect",
          "name": "wait 4000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 4000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/gamemode creative"
          },
          "save": "s1"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/npc spawn Tetrabird"
          },
          "save": "s2"
        },
        {
          "tool": "bot_expect",
          "name": "wait 3000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 3000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch admin skins --radius=6 --set=Base=2002+Crest=2001+Wings=2002"
          },
          "save": "wild"
        },
        {
          "tool": "bot_expect",
          "name": "wild Tetrabird wears the skin pack's Base, Crest and Wings",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${wild.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_animal.admin.skins.line",
                "params": {
                  "role": {
                    "value": "Tetrabird"
                  },
                  "model": {
                    "value": "Tetrabird"
                  },
                  "ids": {
                    "value": "{Base=2002, Crest=2001, Wings=2002}"
                  },
                  "textures": {
                    "value": {
                      "$matches": "^(?=.*Model:Base_2002)(?=.*Model:Crest_2001)(?=.*Model:Wings_2002)[^,]*,[^,]*,[^,]*$"
                    }
                  },
                  "record": {
                    "value": "-"
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch admin befriend"
          },
          "save": "bef"
        },
        {
          "tool": "bot_expect",
          "name": "befriended",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${bef.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_animal.admin.befriend.done"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "name": "client is sent CozyRanch_Tetrabird with the skin's attachments",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "EntityUpdates",
            "cursor": "${bef.cursor}",
            "where": {
              "updates": {
                "$contains": {
                  "updates": {
                    "$contains": {
                      "model": {
                        "assetId": "CozyRanch_Tetrabird",
                        "attachments": {
                          "$contains": {
                            "texture": "NPC/Wildlife/Tetrabird/Models/Attachments/Base_2002.png"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "name": "wait 2000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch admin skins --radius=6"
          },
          "save": "tame"
        },
        {
          "tool": "bot_expect",
          "name": "ranch Tetrabird keeps the skin and its record has it",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${tame.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_animal.admin.skins.line",
                "params": {
                  "role": {
                    "value": "CozyRanch_Tetrabird"
                  },
                  "model": {
                    "value": "CozyRanch_Tetrabird"
                  },
                  "ids": {
                    "value": "{Base=2002, Crest=2001, Wings=2002}"
                  },
                  "count": {
                    "value": 3
                  },
                  "textures": {
                    "value": {
                      "$matches": "^(?=.*Model:Base_2002)(?=.*Model:Crest_2001)(?=.*Model:Wings_2002)[^,]*,[^,]*,[^,]*$"
                    }
                  },
                  "record": {
                    "value": "Tetrabird {Base=2002, Crest=2001, Wings=2002}"
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch stay"
          },
          "save": "s6"
        },
        {
          "tool": "bot_expect",
          "name": "wait 2000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/tp ~3000 ~ ~"
          },
          "save": "s7"
        },
        {
          "tool": "bot_expect",
          "name": "wait 35000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 35000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/tp ~-3000 ~ ~"
          },
          "save": "s8"
        },
        {
          "tool": "bot_expect",
          "name": "wait 8000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 8000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch admin skins --radius=12"
          },
          "save": "reload"
        },
        {
          "tool": "bot_expect",
          "name": "after its chunk unloads and reloads it still wears the skin",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${reload.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_animal.admin.skins.line",
                "params": {
                  "role": {
                    "value": "CozyRanch_Tetrabird"
                  },
                  "ids": {
                    "value": "{Base=2002, Crest=2001, Wings=2002}"
                  },
                  "count": {
                    "value": 3
                  },
                  "textures": {
                    "value": {
                      "$matches": "^(?=.*Model:Base_2002)(?=.*Model:Crest_2001)(?=.*Model:Wings_2002)[^,]*,[^,]*,[^,]*$"
                    }
                  }
                }
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch follow"
          },
          "save": "s10"
        },
        {
          "tool": "bot_expect",
          "name": "wait 2000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 2000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug place tetrabird"
          },
          "save": "place"
        },
        {
          "tool": "bot_expect",
          "name": "Fossil Nest placed",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${place.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.placed"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug use"
          },
          "save": "use"
        },
        {
          "tool": "bot_expect",
          "name": "assigned to the Fossil Nest",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${use.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.assign.done"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug nightfall"
          },
          "save": "s13"
        },
        {
          "tool": "bot_expect",
          "name": "wait 6000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
            "timeoutMs": 6000
          },
          "expect": {
