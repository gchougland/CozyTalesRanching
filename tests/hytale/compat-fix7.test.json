            "packet": "ServerMessage",
            "cursor": "${rel.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_animal.admin.skins.released"
              }
            },
            "timeoutMs": 10000
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_expect",
          "name": "wait 3000 ms",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "NoSuchPacketJustWaiting",
            "cursor": 0,
