{
  "cases": [
    {
      "name": "produce: gate",
      "description": "Assets (species Products, Produce.json, the truffle) parse and match the engine schemas; Java UI references are valid.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
    {
      "name": "produce: truffle item",
      "description": "CozyRanch_Truffle is a clean food item: no errors or warnings, every reference resolves.",
      "steps": [
        {
          "tool": "asset_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Produce/CozyRanch_Truffle.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        }
      ]
    },
    {
      "name": "produce: build and unit tests (happiness, hearts, bountiful, lucky, premium, caps, catch-up, buckets, save file, poop piles)",
      "steps": [
        {
          "tool": "project_build",
          "arguments": {
            "project": "CozyTales-Ranching",
            "system": "gradle",
            "tasks": [
              "build"
            ]
          },
          "waitJob": true,
          "expect": {
            "state": "succeeded"
          }
        }
      ]
    },
    {
      "name": "produce: poop pile",
      "description": "CozyRanch_Poop_Pile (states Count2 to Count8, one drop list per count) is clean, its drop lists resolve to vanilla Ingredient_Poop, and the three pile textures pass the style rules.",
      "steps": [
        {
          "tool": "asset_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Poop/CozyRanch_Poop_Pile.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        },
        {
          "tool": "asset_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Drops/CozyRanch/Poop/Drops_CozyRanch_Poop_8.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        },
        {
          "tool": "texture_check",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Common/Blocks/CozyRanch/Poop",
            "image": false
          },
          "expect": {
            "verdicts": {
              "FAIL": 0
            }
          }
        }
      ]
    }
  ]
}
