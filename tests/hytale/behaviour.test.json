{
  "cases": [
    {
      "name": "behaviour gate",
      "description": "The mod's assets parse and match the engine schemas.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
    {
      "name": "ranch template with behaviour states",
      "description": "The animal template with the Behave, Tag and Meet states, and an adult and a baby variant, pass the engine schema with no warnings.",
      "steps": [
        {
          "tool": "asset_check",
          "name": "template",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/NPC/Roles/CozyRanch/Template_CozyRanch_Animal.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "pig",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/NPC/Roles/CozyRanch/CozyRanch_Pig.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "chick",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/NPC/Roles/CozyRanch/CozyRanch_Chicken_Chick.json"
          },
          "expect": {
            "errors": 0,
            "warnings": 0
          }
        }
      ]
    },
    {
      "name": "behaviour clips resolve on the real models",
      "description": "The clip ids the planner plays (Status slot) are animation sets of the model assets the ranch roles use, and each clip binds to the model's nodes.",
      "steps": [
        {
          "tool": "animation_render",
          "name": "CozyRanch_Cow Graze",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/CozyRanch_Cow.json",
            "animation": "Graze",
            "frames": 4,
            "size": 200
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              }
            }
          }
        },
        {
          "tool": "animation_render",
          "name": "CozyRanch_Cow TailSwish",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/CozyRanch_Cow.json",
            "animation": "TailSwish",
            "frames": 4,
            "size": 200
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              }
            }
          }
        },
        {
          "tool": "animation_render",
          "name": "CozyRanch_Pig MudRoll",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/CozyRanch_Pig.json",
            "animation": "MudRoll",
            "frames": 4,
            "size": 200
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              }
            }
          }
        },
        {
          "tool": "animation_render",
          "name": "CozyRanch_Chicken DustBathe",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/CozyRanch_Chicken.json",
            "animation": "DustBathe",
            "frames": 4,
            "size": 200
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              }
            }
          }
        },
        {
          "tool": "animation_render",
          "name": "CozyRanch_Frog LilyHop",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/CozyRanch_Frog.json",
            "animation": "LilyHop",
            "frames": 4,
            "size": 200
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              }
            }
          }
        },
        {
          "tool": "animation_render",
          "name": "CozyRanch_Sheep Pronk",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Models/CozyRanch/CozyRanch_Sheep.json",
            "animation": "Pronk",
            "frames": 4,
            "size": 200
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              }
            }
          }
        }
      ]
    },
    {
      "name": "toys animate while played with",
      "description": "Each toy item has a looping Play state (ToyAnimator swaps the placed block to it while an animal plays). The clip is drawn through the real item asset; every animated node is a node of the toy model (the duck keeps Gibson's node names), and the strip is held against a golden.",
      "steps": [
        {
          "tool": "animation_render",
          "name": "Toy_Ball Play",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_Ball.json",
            "animation": "Blocks/CozyRanch/Toys/Toy_Ball_Play.blockyanim",
            "frameList": [
              0,
              8,
              12,
              20,
              26,
              32,
              40,
              48
            ],
            "size": 160,
            "hitbox": false,
            "yaw": 80,
            "pitch": 12
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              },
              "animatedNodes": 22,
              "durationFrames": 60
            }
          },
          "golden": "tests/hytale/golden/behaviour/Toy_Ball_Play.png"
        },
        {
          "tool": "animation_render",
          "name": "Toy_ScratchingPost Play",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_ScratchingPost.json",
            "animation": "Blocks/CozyRanch/Toys/Toy_ScratchingPost_Play.blockyanim",
            "frameList": [
              0,
              8,
              12,
              20,
              26,
              32,
              40,
              48
            ],
            "size": 160,
            "hitbox": false,
            "yaw": 20,
            "pitch": 12
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              },
              "animatedNodes": 18,
              "durationFrames": 60
            }
          },
          "golden": "tests/hytale/golden/behaviour/Toy_ScratchingPost_Play.png"
        },
        {
          "tool": "animation_render",
          "name": "Toy_HangingBell Play",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_HangingBell.json",
            "animation": "Blocks/CozyRanch/Toys/Toy_HangingBell_Play.blockyanim",
            "frameList": [
              0,
              8,
              12,
              20,
              26,
              32,
              40,
              48
            ],
            "size": 160,
            "hitbox": false,
            "yaw": 90,
            "pitch": 12
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              },
              "animatedNodes": 15,
              "durationFrames": 60
            }
          },
          "golden": "tests/hytale/golden/behaviour/Toy_HangingBell_Play.png"
        },
        {
          "tool": "animation_render",
          "name": "Toy_FloatingDuck Play",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_FloatingDuck.json",
            "animation": "Blocks/CozyRanch/Toys/Toy_FloatingDuck_Play.blockyanim",
            "frameList": [
              0,
              8,
              12,
              20,
              26,
              32,
              40,
              48
            ],
            "size": 160,
            "hitbox": false,
            "yaw": 60,
            "pitch": 12
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              },
              "animatedNodes": 12,
              "durationFrames": 60
            }
          },
          "golden": "tests/hytale/golden/behaviour/Toy_FloatingDuck_Play.png"
        },
        {
          "tool": "animation_render",
          "name": "Toy_Log Play",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_Log.json",
            "animation": "Blocks/CozyRanch/Toys/Toy_Log_Play.blockyanim",
            "frameList": [
              0,
              8,
              12,
              20,
              26,
              32,
              40,
              48
            ],
            "size": 160,
            "hitbox": false,
            "yaw": -75,
            "pitch": 12
          },
          "expect": {
            "animation": {
              "nodesNotInModel": {
                "$length": 0
              },
              "animatedNodes": 14,
              "durationFrames": 60
            }
          },
          "golden": "tests/hytale/golden/behaviour/Toy_Log_Play.png"
        }
      ]
    }
  ]
}
