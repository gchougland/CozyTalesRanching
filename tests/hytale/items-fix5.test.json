{
  "cases": [
    {
      "name": "items-fix5 gate",
      "description": "The pack validates after the removals (Feather Pillow, Tortoise Scute, Workbench and Fertilizer recipes, Moss Tuft growth).",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0,
            "errors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
