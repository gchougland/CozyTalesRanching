{
  "cases": [
    {
      "name": "bait bowl gate",
      "description": "The Bait Bowl item, block, hitbox and the four models pass their engine checks; the texture is in Hytale's painted style; the pack validates.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0,
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_Bait_Bowl.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_Bait_Bowl.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "Bait bowl hitbox",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Block/Hitboxes/CozyRanch/CozyRanch_Bait_Bowl.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "texture_check",
