{
  "cases": [
    {
      "name": "catalog gate",
      "description": "The pack validates; the creative tab, the bench and every item that names them check against the engine schema.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0,
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Category/CreativeLibrary/CozyRanch.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_RanchingBench.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_RanchingBench.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Block/Hitboxes/CozyRanch/CozyRanch_RanchingBench.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_House_CowBarn.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_CowBarn.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_Toy_Ball.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Toys/CozyRanch_Toy_Ball.json"
          },
          "expect": {
            "errors": 0
          }
        },
        {
          "tool": "asset_check",
          "name": "CozyRanch_Tonic_Fireward.json",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Tonics/CozyRanch_Tonic_Fireward.json"
          },
          "expect": {
            "errors": 0
          }
        }
      ]
    },
    {
      "name": "catalog bench model",
      "description": "Ranching Bench: two cells wide like the Farming bench, blocky, under 255 nodes, painted texture passes the style check.",
      "steps": [
        {
          "tool": "model_render",
          "name": "RanchingBench three quarter",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json",
            "views": [
              "three_quarter",
              "front",
              "back_three_quarter"
            ],
            "grid": true,
            "size": 384
          },
          "expect": {
            "notes": {
              "$length": 0
            },
            "nodes": {
              "$lte": 255
            },
            "sizeBlocks": {
              "width": {
                "$lte": 2
              },
              "height": {
                "$lte": 1.8
              },
              "depth": {
                "$lte": 1
              }
            }
          },
          "golden": "tests/hytale/golden/catalog/RanchingBench.png"
        },
        {
          "tool": "texture_check",
          "name": "RanchingBench texture",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/CozyRanch_RanchingBench.json",
            "image": false
          },
          "expect": {
            "verdict": {
              "$oneOf": [
                "PASS",
                "WARN"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "catalog icons",
      "description": "Bench item icon and the creative tab icons (88 px grey and gold tab, 48 px white sub tabs, like vanilla ItemCategories).",
      "steps": [
