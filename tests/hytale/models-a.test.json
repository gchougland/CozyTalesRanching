          "expect": { "notes": { "$length": 0 }, "nodes": { "$lte": 255 }, "textureSize": [512, 192], "coverage": { "$gt": 0.05 },
            "sizeBlocks": { "width": { "$lte": 3.1 }, "depth": { "$lte": 3.1 }, "height": { "$gt": 1.7, "$lt": 2 } } },
          "golden": "tests/hytale/golden/models-a/pigsty.png" },
        { "tool": "texture_check",
          "arguments": { "root": "projects", "path": "_worktrees/CozyTales-Ranching-models-a/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_Pigsty.json" },
          "expect": { "verdict": { "$oneOf": ["PASS", "WARN"] } } }
