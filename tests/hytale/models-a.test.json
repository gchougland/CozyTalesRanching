{
  "cases": [
    {
      "name": "models-a gate",
      "description": "The pack parses and matches the engine schemas.",
      "steps": [
        { "tool": "asset_validate", "arguments": { "project": "_worktrees/CozyTales-Ranching-models-a" }, "expect": { "valid": true, "schemaErrors": 0 } }
      ]
    },
    {
      "name": "chicken coop",
