      "steps": [
        { "tool": "model_render",
          "arguments": { "root": "projects", "path": "_worktrees/CozyTales-Ranching-models-a/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_ChickenCoop.json", "views": ["three_quarter"], "size": 300 },
          "expect": { "notes": { "$length": 0 }, "nodes": { "$lte": 255 }, "textureSize": [256, 224], "coverage": { "$gt": 0.05 },
            "sizeBlocks": { "width": { "$lte": 2.25 }, "depth": { "$lte": 2.25 }, "height": { "$gt": 2.9, "$lt": 3.15 } } },
          "golden": "tests/hytale/golden/models-a/chicken-coop.png" },
        { "tool": "texture_check",
          "arguments": { "root": "projects", "path": "_worktrees/CozyTales-Ranching-models-a/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_ChickenCoop.json" },
          "expect": { "verdict": { "$oneOf": ["PASS", "WARN"] } } }
      ]
    },
    {
