    {
      "name": "houses-fix4 WolfLodge",
      "description": "Howling wolf sign (blocky relief, moon top left), doorway open from the threshold up, log pile clear of the wall.",
      "steps": [
        {
          "tool": "model_render",
          "name": "WolfLodge",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_WolfLodge.json",
            "views": [
              "front",
              "three_quarter",
              "left"
            ],
            "size": 420
          },
          "expect": {
            "notes": {
              "$length": 0
            },
            "nodes": {
              "$lte": 255
            },
            "coverage": {
              "$gt": 0.05
            },
            "sizeBlocks": {
              "width": {
                "$lte": 4
              },
              "depth": {
                "$lte": 3.6
              },
              "height": {
                "$lte": 4
              }
            }
          },
          "golden": "tests/hytale/golden/houses-fix4/WolfLodge.png"
        },
        {
          "tool": "texture_check",
          "name": "WolfLodge texture",
          "arguments": {
            "root": "projects",
            "path": "CozyTales-Ranching/src/main/resources/Server/Item/Items/CozyRanch/Houses/CozyRanch_House_WolfLodge.json",
            "image": false
          },
          "expect": {
            "verdict": {
              "$oneOf": [
                "PASS",
                "WARN"
              ]
            }
          }
        }
      ]
    },
