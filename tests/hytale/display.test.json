    {
      "name": "display gate",
      "description": "Assets including HouseDisplay.json parse; Java and UI agree.",
      "steps": [
        {
          "tool": "asset_validate",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true,
            "schemaErrors": 0
          }
        },
        {
          "tool": "ui_check_java",
          "arguments": {
            "project": "CozyTales-Ranching"
          },
          "expect": {
            "valid": true
          }
        }
      ]
    },
