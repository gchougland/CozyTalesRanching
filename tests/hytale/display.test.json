    {
      "name": "display live",
      "description": "Port 5596. A songbird aviary turned once: two residents stored at night are shown (their own looks, scale 0.45, intangible) at the rotated points; a reload and refresh make no duplicates; the morning takes them down as they come out; three shown again at night; breaking the house takes them away. Waits are bot_expect on a packet that never comes (no server_scenario, which can hit the MCP job limit while other agents run).",
      "steps": [
        {
          "tool": "server_start",
          "arguments": {
            "artifacts": [
              "CozyTales-Ranching/build/libs/CozyTalesRanching-0.6.0.jar"
            ],
            "authMode": "insecure",
            "port": 5596
          },
          "waitReady": true,
          "save": "server"
        },
        {
          "tool": "server_command",
          "arguments": {
            "jobId": "${server.id}",
            "command": "op add 11111111-2222-4333-8444-555555555555"
          }
        },
        {
          "tool": "bot_start",
          "arguments": {
            "jobId": "${server.id}",
            "uuid": "11111111-2222-4333-8444-555555555555"
          },
          "expect": {
            "state": "ready"
          },
          "save": "bot"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug nightfall"
          },
          "save": "night"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${night.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.nightfall"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug place songbird --rotation=1"
          },
          "save": "placed"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${placed.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_house.debug.placed"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch breed testhouse songbird --role=CozyRanch_Songbird_Bluebird+CozyRanch_Songbird_Finch"
          },
          "save": "house"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${house.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_breeding.debug.testhouse.done"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display refresh"
          },
          "save": "refresh"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${refresh.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.refresh.done",
                "params": {
                  "shown": {
                    "value": 2
                  }
                }
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display status"
          },
          "save": "status1"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${status1.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.status.line",
                "params": {
                  "shown": {
                    "value": 2
                  },
                  "points": {
                    "value": 3
                  },
                  "inside": {
                    "value": 2
                  },
                  "models": {
                    "value": {
                      "$matches": "^(?=.*\\[CozyRanch_Songbird_Bluebird x0\\.45 at [^\\]]* intangible\\])(?=.*\\[CozyRanch_Songbird_Finch x0\\.45 at [^\\]]* intangible\\])(?=.*yaw -90 intangible)(?=.*yaw -105 intangible)"
                    }
                  }
                }
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch reload"
          },
          "save": "reload"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display refresh"
          },
          "save": "refresh2"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${refresh2.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.refresh.done",
                "params": {
                  "shown": {
                    "value": 2
                  }
                }
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug morning"
          },
          "save": "morning"
        },
        {
          "tool": "bot_expect",
          "name": "wait for: came out of house",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "WaitOnlyNoSuchPacket",
            "timeoutMs": 4000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display status"
          },
          "save": "status3"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${status3.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.status.line",
                "params": {
                  "shown": {
                    "value": 0
                  },
                  "inside": {
                    "value": 0
                  }
                }
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch house debug nightfall"
          },
          "save": "night2"
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch breed testhouse songbird --role=CozyRanch_Songbird_Sparrow"
          },
          "save": "house2"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${house2.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_breeding.debug.testhouse.done"
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display refresh"
          },
          "save": "refresh3"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${refresh3.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.refresh.done",
                "params": {
                  "shown": {
                    "value": {
                      "$gte": 2
                    }
                  }
                }
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/block set ~ ~ ~ Empty"
          },
          "save": "broke"
        },
        {
          "tool": "bot_expect",
          "name": "wait for: removed (block gone)",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "WaitOnlyNoSuchPacket",
            "timeoutMs": 13000
          },
          "expect": {
            "matched": false
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display refresh"
          },
          "save": "refresh4"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${refresh4.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.refresh.done",
                "params": {
                  "shown": {
                    "value": 0
                  }
                }
              }
            }
          },
          "expect": {
            "matched": true
          }
        },
        {
          "tool": "bot_send",
          "arguments": {
            "botId": "${bot.botId}",
            "op": "chat",
            "text": "/ranch display status"
          },
          "save": "status5"
        },
        {
          "tool": "bot_expect",
          "arguments": {
            "botId": "${bot.botId}",
            "packet": "ServerMessage",
            "cursor": "${status5.cursor}",
            "where": {
              "message": {
                "messageId": "cozyranch_display.status.none"
              }
            }
          },
          "expect": {
            "matched": true
          }
        }
      ]
    }
  ]
}