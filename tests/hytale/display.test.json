    {
      "name": "display rotations",
      "description": "The aviary turned to yaw 1, 2 and 3: the birds stay on the perches in front of the holes and look out of the door side.",
      "steps": [
        {
          "tool": "prefab_render",
          "name": "rotation1",
          "arguments": {
            "path": "CozyTales-Ranching/tests/hytale/display/Rotation1.prefab.json",
            "views": [
              "east",
              "top"
            ],
            "size": 400
          },
          "golden": "tests/hytale/golden/display/Rotation1.png"
        },
        {
          "tool": "prefab_render",
          "name": "rotation2",
          "arguments": {
            "path": "CozyTales-Ranching/tests/hytale/display/Rotation2.prefab.json",
            "views": [
              "north",
              "top"
            ],
            "size": 400
          },
          "golden": "tests/hytale/golden/display/Rotation2.png"
        },
        {
          "tool": "prefab_render",
          "name": "rotation3",
          "arguments": {
            "path": "CozyTales-Ranching/tests/hytale/display/Rotation3.prefab.json",
            "views": [
              "west",
              "top"
            ],
            "size": 400
          },
