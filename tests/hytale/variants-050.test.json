   "name": "variant journal pages",
   "description": "Sheep, pig and chicken journal pages with the longer descriptions that mention the looks.",
   "steps": [
    {
     "tool": "ui_render",
     "name": "sheep journal page (top of the left page) with the new looks in its description",
     "arguments": {
      "root": "projects",
      "path": "CozyTales-Ranching/src/main/resources/Common/UI/Custom/CozyRanch/JournalSpecies.ui",
      "commands": [
       {
        "type": "Append",
        "text": "CozyRanch/JournalSpecies.ui"
       },
       {
        "type": "Set",
        "selector": "#SpeciesName.TextSpans",
        "data": {
         "MessageId": "cozyranch_species.sheep.name"
